{
  "rewrites": [
    {
      "source": "/mahjong_calculator/mahjongcalculator",
      "destination": "/privacy.html"
    },
    {
      "source": "/mahjong_calculator/mahjongcalculatorpp",
      "destination": "/privacy.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/app-ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
